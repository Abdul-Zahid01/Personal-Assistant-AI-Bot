# ---- Core -------------------------------------------------------------------------------
APP_ENV=development            # anything else (e.g. production) REQUIRES API_KEY and a real SECRET_KEY
SECRET_KEY=change-me           # encrypts stored Google tokens and signs OAuth state
API_KEY=                       # clients send this as the X-API-Key header (the web UI asks for it once)
TIMEZONE=Asia/Karachi          # your IANA timezone; can also be changed later by chatting with the bot

# SQLite is the default and needs nothing. For Postgres:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/personal_ai
DATABASE_URL=sqlite+aiosqlite:///./assistant.db
AUTO_CREATE_TABLES=true        # set false if you manage the schema with `alembic upgrade head`

# ---- LLM (optional: without a key the bot understands only simple commands) ---------------
LLM_PROVIDER=gemini            # gemini | openai  (the other one is used as a backup if its key is set)
GEMINI_API_KEY=
# One or more models, comma separated: if one is overloaded or rate-limited the next is tried.
GEMINI_MODEL=gemini-3.5-flash,gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Reply with the tool's own confirmation (1 LLM call per action instead of 2). Good for free-tier keys.
FAST_REPLIES=true

# ---- Notifications (Web Push) -----------------------------------------------------------
# Click the bell in the web app to get notifications even when the tab is closed.
WEB_PUSH_ENABLED=true
# Push services want a contact address. Use your own email (Apple/iPhone requires a real one).
VAPID_SUBJECT=mailto:you@example.com

# ---- Telegram (how the assistant reaches you) ---------------------------------------------
# 1) talk to @BotFather -> /newbot -> paste the token  2) start the app, message your bot,
# it replies with your chat id -> paste it below and restart.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MODE=polling          # polling works anywhere (laptop, home server). webhook needs a public https URL
TELEGRAM_WEBHOOK_SECRET=

# ---- Google Calendar (optional) -----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_CALENDAR_NAME=Assistant # planned blocks go to this calendar (created for you); "primary" = your main one

# ---- Scheduler ----------------------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
